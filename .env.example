# Ridgeline Quote Approvals — environment variables (names only; copy to .env and fill in).
# Every variable is optional: the default shown in each comment is used when it is unset.
# No variable here is a secret. Real credentials (stock API token, DB password) would go in a secret store.

# HTTP port for the API. Default: 3000
PORT=

# Fixed processing time (ISO 8601) for deterministic runs; unset = wall clock.
# Sample-data value (policy header): 2026-10-12T09:30:00-05:00
AS_OF=

# Stock source: "http" (real API / mock) or "fixture" (offline JSON file). Default: http
STOCK_CLIENT=
# Stock API base URL. Default: http://localhost:8080 (data-pack/mock_stock_api.py)
STOCK_API_URL=
# Per-attempt timeout in ms. Default: 1000
STOCK_TIMEOUT_MS=
# Total attempts before marking stock unavailable. Default: 4
STOCK_MAX_ATTEMPTS=
# Backoff base delay in ms (exponential with jitter, capped at 5000). Default: 200
STOCK_BASE_DELAY_MS=
# Fixture file used when STOCK_CLIENT=fixture. Default: data-pack/stock_fixture.json
STOCK_FIXTURE_PATH=

# Read-only reporting snapshot directory (CSV + export_metadata.json). Default: data-pack/reporting_db
REPORTING_DB_DIR=
# App store (quotes, approvals, audit log). Default: data/app.db — use :memory: for a throwaway run
APP_DB_PATH=
# Approval rules (thresholds, roles, staleness, backup depth). Default: config/approval-rules.json
RULES_PATH=
# Service accounts allowed to call the API (e.g. intake). Default: config/service-users.json
SERVICE_USERS_PATH=

# Batch CLI output folder. Default: outputs
OUTPUT_DIR=
